# Default watchlist (comma-separated tickers)
DEFAULT_WATCHLIST=ADBE,NOW,MSFT,AAPL,GOOGL,META,NVDA,AMD,CRM,ORCL

# Cache TTL in seconds for price data (15 minutes default)
CACHE_TTL_SECONDS=900

# Server config
HOST=127.0.0.1
PORT=8000

# SEC EDGAR requires every request to identify a contact (name + email).
# Used only for requests to sec.gov.
SEC_USER_AGENT=QuantAnalyzer research (Your Name, you@example.com)
